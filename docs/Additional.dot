digraph G {graph [rankdir=LR];node [shape=record,fontname="DejaVu Sans", fontsize=11]; Rectangle [label="{Rectangle|- width: double = -1\l- height: double = -1\l|+ Rectangle()\l+ Rectangle(width, height)\l+ getArea(): double\l+ getPerimeter(): double\l}"]; Stock [label="{Stock|- symbol: String\l- name: String\l- previousClosingPrice: double\l- currentPrice: double\l|+ Stock(symbol, name)\l+ getChangePercent(): double\l}"]; }