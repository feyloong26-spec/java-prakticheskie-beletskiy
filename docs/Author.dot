digraph G {graph [rankdir=LR];node [shape=record, fontname="DejaVu Sans", fontsize=11]; Author [label="{Author| - name: String\l - email: String\l - gender: char\l| + Author(name, email, gender)\l + getName(): String\l + getEmail(): String\l + setEmail(email): void\l + getGender(): char\l + toString(): String\l}"]; TestAuthor [label="{TestAuthor|+ main(args): void}"]; TestAuthor -> Author [style=dashed];}