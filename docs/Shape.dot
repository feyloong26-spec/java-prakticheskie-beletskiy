digraph G {graph [rankdir=TB];node [shape=record,fontname="DejaVu Sans", fontsize=11]; Shape [label="{«abstract» Shape|# color: String\l# filled: boolean\l|+ getColor(), setColor()\l+ isFilled(), setFilled()\l+ getArea(): double (abstract)\l+ getPerimeter(): double (abstract)\l+ toString(): String\l}"]; Circle [label="{Circle|# radius: double|+ getRadius(), setRadius()\l+ getArea(), getPerimeter()\l}"]; Rectangle [label="{Rectangle|# width: double\l# length: double\l|+ getWidth(), getLength()\l+ getArea(), getPerimeter()\l}"]; Square [label="{Square||+ getSide(), setSide()\l+ setWidth(), setLength()\l}"]; Circle -> Shape [arrowhead=empty]; Rectangle -> Shape [arrowhead=empty]; Square -> Rectangle [arrowhead=empty];}